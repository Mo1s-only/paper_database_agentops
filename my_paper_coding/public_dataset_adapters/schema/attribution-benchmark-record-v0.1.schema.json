{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentops-thesis.local/schema/attribution-benchmark-record-v0.1.schema.json",
  "title": "Attribution benchmark record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset", "run", "agents", "steps", "relations", "truth", "provenance", "quality"],
  "properties": {
    "schema_version": {"const": "attribution-benchmark-record-v0.1"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "split"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "split": {"type": "string", "minLength": 1}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "session_id", "task_id"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "session_id": {"type": ["string", "null"]},
        "task_id": {"type": ["string", "null"]}
      }
    },
    "agents": {
      "type": "array",
      "items": {"$ref": "#/$defs/agent"}
    },
    "steps": {
      "type": "array",
      "items": {"$ref": "#/$defs/step"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responsibility_agents", "responsibility_steps", "root_cause_nodes", "propagation_edges", "causal_paths"],
      "properties": {
        "responsibility_agents": {"$ref": "#/$defs/truthLabel"},
        "responsibility_steps": {"$ref": "#/$defs/truthLabel"},
        "root_cause_nodes": {"$ref": "#/$defs/truthLabel"},
        "propagation_edges": {"$ref": "#/$defs/truthLabel"},
        "causal_paths": {"$ref": "#/$defs/truthLabel"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "source_records"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "source_records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_path", "sha256"],
            "properties": {
              "source_path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": true,
      "required": ["warnings", "relation_opportunities", "relations_reconstructed"],
      "properties": {
        "warnings": {"type": "array", "items": {"type": "string"}},
        "relation_opportunities": {"type": "integer", "minimum": 0},
        "relations_reconstructed": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "json_pointer", "record_sha256", "support", "method"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "json_pointer": {"type": "string"},
        "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "support": {"enum": ["direct", "derived"]},
        "method": {"type": "string", "minLength": 1}
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": true,
      "required": ["agent_id", "role", "evidence"],
      "properties": {
        "agent_id": {"type": "string", "minLength": 1},
        "role": {"type": ["string", "null"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": true,
      "required": ["step_id", "sequence", "agent_id", "event_type", "timestamp", "content_sha256", "evidence"],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "sequence": {"type": "integer", "minimum": 0},
        "agent_id": {"type": ["string", "null"]},
        "event_type": {"type": "string", "minLength": 1},
        "timestamp": {"type": ["string", "null"]},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["relation_id", "source_step_id", "target_step_id", "relation_type", "evidence"],
      "properties": {
        "relation_id": {"type": "string", "minLength": 1},
        "source_step_id": {"type": "string", "minLength": 1},
        "target_step_id": {"type": "string", "minLength": 1},
        "relation_type": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "truthLabel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "values", "reason", "evidence"],
      "properties": {
        "state": {"enum": ["direct", "derived", "partial", "abstain"]},
        "values": {"type": "array"},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "abstain"}}},
          "then": {"properties": {"values": {"maxItems": 0}, "evidence": {"maxItems": 0}}},
          "else": {"properties": {"values": {"minItems": 1}, "evidence": {"minItems": 1}}}
        }
      ]
    }
  }
}
